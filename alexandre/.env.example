# Copier ce fichier en .env puis remplir. Le fichier .env n'est jamais commité.

# --- LLM (obligatoire) : clé Gemini, https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash

# --- LLM de secours (optionnel) : activé seulement si la clé est renseignée
MISTRAL_API_KEY=
FALLBACK_MODEL=mistral-small-latest

# --- Notion (obligatoire) : token d'intégration + IDs des 4 bases
NOTION_TOKEN=
STOCK_DB_ID=
VENTES_DB_ID=
CATALOGUE_DB_ID=
COMMANDES_DB_ID=

# --- Email SMTP (optionnel, tout ou rien) : Mailtrap recommandé
# Sans ces variables, la lecture et la prévision fonctionnent, l'envoi est désactivé.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Démo : date « d'aujourd'hui » pour les données de février 2026
DATE_REFERENCE=2026-02-16
# Dossier des traces locales (commandes envoyées mais non enregistrées)
TRACE_DIR=var
